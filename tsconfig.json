{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "composite": true,
    "resolveJsonModule": true
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/memory" },
    { "path": "apps/cli" }
  ],
  "exclude": ["node_modules", "dist"]
}
